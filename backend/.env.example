# DirectAct-AI Backend Environment Configuration

# LLM Provider (gemini or openai)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
APP_NAME=DirectAct-AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=info

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./directact.db

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_COMMANDS_WHITELIST=notepad,calc,explorer,chrome,msedge
MAX_SESSION_DURATION_MINUTES=480

# VirusTotal API (Phase 10)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Audit Settings
AUDIT_LOG_PATH=./logs/audit.log
SCREENSHOT_PATH=./logs/screenshots
