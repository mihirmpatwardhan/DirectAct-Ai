# DirectAct-AI Backend Environment Configuration

# LLM Provider (gemini or openai)
LLM_PROVIDER=groq
# Keep startup fast. Set true only when API keys are stored in Windows Credential Manager.
LLM_USE_KEYRING=false
# Fast failover: each unhealthy key is skipped after this many seconds, while
# the agent can use the full decision budget across all configured fallback keys.
LLM_ATTEMPT_TIMEOUT_SECONDS=8
AGENT_LLM_TIMEOUT_SECONDS=35

# Groq API Keys (Fast LPU inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=your_groq_key1,your_groq_key2
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Keys (optional fallback pool)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_gemini_key1,your_gemini_key2

# OpenAI API Keys (optional fallback pool)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEYS=your_openai_key1,your_openai_key2

# NVIDIA NIM API Keys (optional fallback pool)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_KEYS=your_nvidia_key1,your_nvidia_key2
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Application Settings
APP_NAME=DirectAct-AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=info

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./directact.db

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_COMMANDS_WHITELIST=notepad,calc,explorer,chrome,msedge
MAX_SESSION_DURATION_MINUTES=480

# VirusTotal API (Phase 10)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Audit Settings
AUDIT_LOG_PATH=./logs/audit.log
SCREENSHOT_PATH=./logs/screenshots

# Chrome Profile & Browser Automation
# Live mode uses the user's already-open Chrome tab through the local
# chrome-extension bridge. It never copies a profile or opens Guest Chrome.
MCP_USE_SYSTEM_CHROME=true
CHROME_PROFILE_NAME=Default
CHROME_USER_DATA_DIR=
MCP_DEFAULT_HEADLESS=false
MAX_AGENT_STEPS=100
